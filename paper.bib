@article{steinebachConstructionRosenbrockWanner2023,
  title = {Construction of {{Rosenbrock}}--{{Wanner}} Method {{Rodas5P}} and Numerical Benchmarks within the {{Julia Differential Equations}} Package},
  author = {Steinebach, Gerd},
  year = 2023,
